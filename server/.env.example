PORT=5000

# Database (XAMPP defaults: user "root", empty password)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_resume_analyzer

# Browser origins allowed to call the API (comma separated). Leave unset in development: any localhost port works.
# CLIENT_ORIGIN=https://your-site.example

# Python ML service
PYTHON_SERVICE_URL=http://127.0.0.1:5001

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace-with-your-gemini-api-key
